<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GarageManagerMAIU.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GarageManagerMAIU"
    xmlns:pages="clr-namespace:GarageManagerMAIU.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="GarageManagerMAIU">

    <ShellContent
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="MainPage" />

    <TabBar>
        <Tab Title="Home">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>
        <Tab Title="Ordem de Serviço">
            <ShellContent ContentTemplate="{DataTemplate pages:OrdemServicoPage}" />
        </Tab>
    </TabBar>
</Shell>
